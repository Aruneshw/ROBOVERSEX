# --- core ---
PUBLIC_BASE_URL=http://192.168.1.50          # or your tunnel URL https://arena.example.org
COOKIE_SECURE=false                          # true when served over HTTPS (tunnel mode)
JWT_SECRET=change-me-64-hex-chars            # openssl rand -hex 32
COMMON_USERNAME=roboverse
COMMON_BOOTSTRAP_PASSWORD=change-me
ADMIN_BOOTSTRAP_PASSWORD=change-me-too
# --- data ---
POSTGRES_USER=rvx
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=rvx
DATABASE_URL=postgresql+asyncpg://rvx:change-me-db@db:5432/rvx
REDIS_URL=redis://redis:6379/0
TRACE_DIR=/data/traces
# --- judge ---
RUNNER_IMAGE=rvx-runner:1.0.0
JUDGE_CONCURRENCY=4                          # ≈ CPU cores − 2
JUDGE_WALL_TIMEOUT_S=10
# --- public access (optional) ---
CLOUDFLARE_TUNNEL_TOKEN=
# --- Phase 9 Live ROS Lab (optional) ---
LIVE_LAB_ENABLED=false
LAB_IMAGE=rvx-ros-lab:1.0.0
LAB_NETWORK=roboverse_labnet
MAX_LIVE_LABS=10
LAB_IDLE_MINUTES=20
